# Copy to .env and fill in. NEVER commit real values.
#
# This scraper is multi-tenant: it reads every row of the `profiles` table
# and scrapes/posts per-user, using each user's own search_term/location/
# hours_old from the Settings page. New users need zero changes here — they
# just sign up and fill in their Settings; the next scheduled run picks
# them up automatically.

# --- Required ----------------------------------------------------------------
# Full webhook URL (see the /integrations page in the running web app)
WEBHOOK_URL="https://your-app.example.com/api/public/ingest-jobs"

# Must match the web app's INGEST_SECRET env var exactly.
# Generate once: openssl rand -hex 32
INGEST_SECRET="paste-the-same-value-set-on-the-web-app-here"

# Same values the web app uses (server-only). Used here only to read the
# `profiles` table (user_id, search_term, location, hours_old) — never
# exposed to end users.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="paste-the-same-value-set-on-the-web-app-here"

# --- Scrape tuning (applies to every user's run) ------------------------------
RESULTS_WANTED=50
COUNTRY_INDEED="india"
# Comma-separated. Options: linkedin, indeed, naukri, zip_recruiter, glassdoor, google, bayt, bdjobs
JOBSPY_SITES="linkedin,indeed,naukri"

# --- Behavior ----------------------------------------------------------------
LINKEDIN_FETCH_DESCRIPTION=true
BATCH_SIZE=100
LOG_LEVEL=INFO
