# Copy to .env and fill in.
# NEVER commit the real .env — see .gitignore.
#
# No Lovable account is required anywhere in this file. Create your own free
# accounts at supabase.com and aistudio.google.com — both have no-cost tiers
# with no credit card required at signup.

# Supabase — create your OWN project at https://supabase.com/dashboard (free tier).
# publishable/anon key is safe to expose; service role must NOT go here.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Vite mirrors — same values, VITE_ prefix required for client-side access
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secrets (NEVER commit real values)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."   # from Supabase → Project Settings → API
GEMINI_API_KEY=""                             # free key: https://aistudio.google.com/app/apikey
INGEST_SECRET="generate-with: openssl rand -hex 32"
CRON_SECRET="generate-with: openssl rand -hex 32"

# On-demand scrape trigger (optional): after a user saves Settings, the web
# app tells the EC2 box running scraper.py to scrape just that user right
# away via AWS SSM RunCommand, instead of waiting for the next scheduled run.
# If unset, Settings saves still work fine — the trigger is just skipped.
# IAM user needs ssm:SendCommand scoped to SCRAPER_EC2_INSTANCE_ID, plus
# ssm:GetCommandInvocation/ListCommandInvocations/DescribeInstanceInformation.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SCRAPER_EC2_INSTANCE_ID="i-xxxxxxxxxxxxxxxxx"
